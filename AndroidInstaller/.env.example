# Copy to .env. Paths should be absolute; never commit this file.
ANDROID_SDK_BASE="$HOME/Android/Sdk/build-tools/34.0.0"
TARGET_APK="$HOME/Game.apk"
UNITY_INSTALLATION_BASE="$HOME/Unity/EditorVersion"
DEXPATCHER="$HOME/dexpatcher/bin/dexpatcher"
MONO_BCL_DIR="$HOME/android-mono/sdks/out/android-bcl/monodroid"
MONO_LIB_DIR="$HOME/android-mono/sdks/out/android-arm64-v8a-debug/lib"
BHAPTICS_LIB="$HOME/android-deps/libbhaptics-native-lib.so"
KEYSTORE="$HOME/android-signing.keystore"
KEY_ALIAS="androiddebugkey"
# Export KEYSTORE_PASSWORD and, if different, KEY_PASSWORD in your shell.
